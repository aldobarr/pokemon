{
  "name": "pokemon",
  "version": "1.0.0",
  "description": "Pokemon Game",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "fix": "npm run lint:fix && npm run format",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "prebuild": "npm run clean && npm run fix",
    "build": "esbuild ./src/main.ts --bundle --format=iife --target=es2022 --sourcemap --outfile=dist/bundle.js",
    "start": "esbuild ./src/main.ts --bundle --format=iife --target=es2022 --sourcemap --outfile=dist/bundle.js --servedir=. --serve=8000",
    "watch": "esbuild ./src/main.ts --bundle --format=iife --target=es2022 --sourcemap --outfile=dist/bundle.js --watch"
  },
  "author": "",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "pixi.js": "^5.3.12",
    "spatial-hashmap": "^1.0.6"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
