{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": [
			"ES2022",
			"DOM",
			"DOM.Iterable"
		],
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"noEmit": true,
		"strict": true,
		"sourceMap": true,
		"skipLibCheck": true
	},
	"include": [
		"src/**/*.ts",
		"data/**/*.json"
	],
	"exclude": [
		"dist",
		"node_modules"
	]
}
